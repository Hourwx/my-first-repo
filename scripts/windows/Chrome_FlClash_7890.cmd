@echo off
chcp 65001 >nul
set "CHROME_FLCLASH_CHECK="
if /i "%~1"=="--check-only" set "CHROME_FLCLASH_CHECK=-CheckOnly"
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -Command "& { param([switch]$CheckOnly); $ErrorActionPreference = 'Stop'; $homeUrl = 'https://chatgpt.com/'; function Get-ChromeLaunchMode { param([object[]]$Processes); if (@($Processes).Count -eq 0) { return 'fresh'; }; if (@($Processes | Where-Object { -not $_.CommandLine }).Count -gt 0) { return 'unknown'; }; $roots = @($Processes | Where-Object { $_.CommandLine -notmatch '(?:^|\s)--type=' }); if ($roots.Count -ne 1) { return 'conflict'; }; $line = $roots[0].CommandLine; if ($line -match '(?:^|\s)--(?:user-data-dir|no-proxy-server|proxy-pac-url|proxy-auto-detect|proxy-bypass-list)(?:=|\s|$)') { return 'conflict'; }; $proxyMatches = $line -match '(?:^|\s)--proxy-server=(?:http://127\.0\.0\.1:7890|\x22http://127\.0\.0\.1:7890\x22)(?:\s|$)'; $quicMatches = $line -match '(?:^|\s)--disable-quic(?:\s|$)'; if ($proxyMatches -and $quicMatches) { return 'reuse'; }; return 'conflict'; }; function Show-LaunchMessage { param([string]$Message); Add-Type -AssemblyName System.Windows.Forms; [void][System.Windows.Forms.MessageBox]::Show($Message, 'Chrome - FlClash', 'OK', 'Information'); }; try { $candidates = @(); foreach ($base in @($env:ProgramFiles, ${env:ProgramFiles(x86)}, $env:LOCALAPPDATA)) { if ($base) { $candidates += (Join-Path $base 'Google\Chrome\Application\chrome.exe'); }; }; $chromePath = $candidates | Where-Object { Test-Path -LiteralPath $_ -PathType Leaf } | Select-Object -First 1; if (-not $chromePath) { throw '未找到 Chrome 安装文件。'; }; $listeners = @(Get-NetTCPConnection -State Listen -LocalPort 7890 -ErrorAction SilentlyContinue | Where-Object { $_.LocalAddress -in @('127.0.0.1', '0.0.0.0') }); $flclashListeners = @($listeners | Where-Object { $owner = Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue; $owner -and $owner.ProcessName -eq 'FlClashCore'; }); $proxyReady = $flclashListeners.Count -gt 0; $chromeProcesses = @(Get-CimInstance Win32_Process -Filter ('Name=' + [char]39 + 'chrome.exe' + [char]39) -ErrorAction Stop); $mode = Get-ChromeLaunchMode -Processes $chromeProcesses; if ($CheckOnly) { [pscustomobject]@{ ProxyReady = $proxyReady; ChromeMode = $mode; ChromePath = $chromePath; WouldLaunch = ($proxyReady -and $mode -in @('fresh', 'reuse')); } | ConvertTo-Json -Compress; return; }; if (-not $proxyReady) { Show-LaunchMessage '请先开启 FlClash，确认混合端口为 7890。当前没有检测到 FlClashCore 在本地 IPv4 的 7890 端口监听。'; return; }; if ($mode -notin @('fresh', 'reuse')) { Show-LaunchMessage 'Chrome 已运行，但启动参数与已验证方式不一致，或无法确认。请保存工作后，在 Chrome 地址栏输入 chrome://quit 正常退出，再双击此入口。此入口不会强制结束进程。'; return; }; Start-Process -FilePath $chromePath -ArgumentList @('--proxy-server=http://127.0.0.1:7890', '--disable-quic', $homeUrl) -WindowStyle Normal; } catch { if ($CheckOnly) { throw; }; Show-LaunchMessage ('启动检查未完成：' + $_.Exception.Message); }; } %CHROME_FLCLASH_CHECK%"
exit /b %errorlevel%
